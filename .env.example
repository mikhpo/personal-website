# Конфигурация проекта: один файл, секции по независимым параметрам
# развертывания (приложение, база данных, хранилище, прокси, бэкапы,
# реестры/CI). Сочетания вариантов образуют сценарии развертывания -
# матрица параметров и эталонные сценарии: docs/deployment/matrix.md.
#
# Экранирование символа доллара зависит от способа запуска: Docker Compose
# интерполирует значения .env, каждый $ удваивается ($$); docker run
# --env-file и systemd EnvironmentFile читают значения буквально
# (см. docs/CONTRIBUTING.md, раздел «Экранирование символа доллара»).

# ----------------------------------------------------------------------------
# Приложение
# Рецепты запуска (Compose, docker run, systemd Gunicorn): docs/deployment/application.md
# ----------------------------------------------------------------------------

# Должно принимать значение True в непродуктивной среде или False в продуктивной среде.
DEBUG=True/False

# Секретный ключ проекта Django.
# Внимание: для Docker Compose каждый символ $ в значении экранируется
# удвоением ($ -> $$), иначе compose выполняет интерполяцию переменных
# и молча искажает значение (см. CONTRIBUTING, раздел «Экранирование символа доллара»).
SECRET_KEY='secret-django-key'

# Номер порта, на котором приложение ожидает входящие соединения.
# Контейнерные режимы публикуют порт только на 127.0.0.1 хоста, systemd-режим
# слушает 127.0.0.1 напрямую: внешний трафик всегда проходит через прокси-слой.
DJANGO_PORT='8000'

# Количество воркеров Gunicorn в продуктивном режиме.
# Пусто - формула по умолчанию: (2 × число логических ядер CPU) + 1.
# Целое число - ограничение потребления оперативной памяти на слабом железе.
GUNICORN_WORKERS=''

# Имя домена, по которому доступен сайт по протоколу HTTPS.
# Из домена автоматически собираются ALLOWED_HOSTS, CORS_ALLOWED_ORIGINS
# и CSRF_TRUSTED_ORIGINS (сам домен и www-поддомен). Значения по умолчанию
# нет намеренно: домен не должен попадать в git-репозиторий.
DOMAIN_NAME='example.com'

# Редирект всех входящих HTTP-запросов на HTTPS на уровне Django.
# Включать (True), если редирект не выполняется самим прокси.
SECURE_SSL_REDIRECT=False

# Длительность HSTS в секундах: 0 - выключен, продуктивное значение - 31536000
# (год). HSTS запоминается браузерами: включать только при уверенном HTTPS
# на домене (включая поддомены).
SECURE_HSTS_SECONDS=0

# Передача cookies сессии и CSRF только по HTTPS (продуктивное значение - True).
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# Доверие заголовку X-Forwarded-Proto от прокси: Django считает запрос
# защищенным, если прокси передал протокол https (продуктивное значение - True).
# Требуется за прокси с терминацией TLS (хостовый nginx, Traefik), когда
# на уровне Django включены редирект или secure cookies.
SECURE_PROXY_SSL_HEADER=False

# Адрес электронной почты для отправки рассылок.
EMAIL_HOST_USER='username@example.com'

# Пароль от электронной почты для отправки рассылок.
EMAIL_HOST_PASSWORD='email-service-password'

# Базовый URL статических файлов для Django ({% static %}).
# Локально: '/static/'. В S3-режиме: адрес бакета или CDN с префиксом static/,
# например 'https://storage.yandexcloud.net/<bucket>/static/'.
STATIC_URL='/static/'

# publicPath для webpack-сборки фронтенда: URL-префикс бандлов в webpack-stats.json
# (влияет в том числе на lazy-chunks). Должен совпадать со STATIC_URL используемой среды.
WEBPACK_PUBLIC_PATH='/static/'

# Каталог для сохранения статических файлов. Например, /srv/personal-website/static.
# Используется только вне S3-режима (раздача через WhiteNoise).
STATIC_ROOT='/path/to/static/dir'

# Каталог медиафайлов при STORAGE_TYPE=filesystem.
# Например, /srv/personal-website/storage.
STORAGE_ROOT='/path/to/storage/dir'

# Каталог локальных дампов БД системы резервного копирования.
# Например, /srv/personal-website/backups.
BACKUP_ROOT='/path/to/backups/dir'

# Каталог для сохранения файлов логов. Например, /srv/personal-website/logs.
LOGS_ROOT='/path/to/logs/dir'

# Каталог для сохранения временных файлов. Например, /srv/personal-website/temp.
TEMP_ROOT='/path/to/temp/dir'

# Имя проекта используется в наименовании файлов и путей.
PROJECT_NAME='project_name'

# Механизм развертывания для общих скриптов деплоя и бэкапов
# (scripts/deploy.sh, scripts/backup.sh).
# compose - приложение разворачивается Docker Compose (scripts/docker/deploy.sh);
# systemd - развертывание в операционной системе хоста (scripts/server/deploy.sh).
# Пусто или отсутствие переменной - как compose.
DEPLOY_MODE='compose'

# Маркер Docker-окружения: приложение запускается в контейнерах Docker Compose.
# Используется как признак среды развертывания при диагностике.
DOCKER_ENV=True

# ----------------------------------------------------------------------------
# База данных
# Варианты размещения (managed, контейнер, systemd на хосте): docs/deployment/database.md
# ----------------------------------------------------------------------------

# Имя пользователя PostgreSQL.
POSTGRES_USER='username'

# Пароль пользователя PostgreSQL.
POSTGRES_PASSWORD='password'

# Имя хоста, на котором размещен кластер PostgreSQL: postgres внутри
# compose-сети, host.docker.internal для systemd-PostgreSQL на хосте,
# FQDN managed-кластера (например, c-<cluster_id>.rw.mdb.yandexcloud.net).
POSTGRES_HOST='db-hostname'

# Номер порта, по которому доступен кластер PostgreSQL (6432 у Yandex Cloud).
POSTGRES_PORT='5432'

# Имя основной базы данных PostgreSQL для сайта.
POSTGRES_DB='db_name'

# Режим SSL подключения (читает Django; стандарт PostgreSQL: disable, allow,
# prefer, require, verify-ca, verify-full):
#   prefer - пытаться использовать SSL, продолжить без шифрования при недоступности (дефолт для локалки),
#   require - требовать SSL, но не проверять сертификат,
#   verify-full - требовать SSL, проверить CA и имя хоста (рекомендуется для managed-сервисов);
#   подробнее: https://www.postgresql.org/docs/current/libpq-ssl.html
POSTGRES_SSL_MODE='prefer'

# Канонический путь к файлу сертификата CA, который читает Django (sslrootcert).
# Дефолт ~/.postgresql/root.crt (конвенция libpq). Для нестандартного размещения указать абсолютный путь.
POSTGRES_SSL_ROOT_CERT_PATH=''

# Путь к сертификату на хосте, куда пишет pgcert.sh и откуда compose монтирует.
# Нужен только в Docker, когда пути хоста и контейнера различаются.
# Если не задан - откатывается на POSTGRES_SSL_ROOT_CERT_PATH.
POSTGRES_SSL_CERT_HOST_PATH=''

# URL для скачивания сертификата CA скриптом scripts/pgcert.sh, например
# 'https://storage.yandexcloud.net/cloud-certs/CA.pem' для Yandex Cloud.
# Непустое значение - триггер загрузки; пустое - сертификат не скачивается
# (например, для провайдеров без статического URL: сертификат помещается вручную).
POSTGRES_SSL_CERT_URL=''

# ----------------------------------------------------------------------------
# Хранилище
# Варианты (filesystem, S3 удаленный, локальный MinIO): docs/deployment/storage.md
# ----------------------------------------------------------------------------

# Тип хранилища: filesystem (по умолчанию) или s3.
# При s3 статика и медиа обслуживаются объектным хранилищем
# (см. docs/deployment/storage.md).
STORAGE_TYPE='filesystem'

# Ключ доступа AWS/S3 (требуется при STORAGE_TYPE=s3).
AWS_ACCESS_KEY_ID='your-access-key-id'

# Секретный ключ AWS/S3 (требуется при STORAGE_TYPE=s3).
AWS_SECRET_ACCESS_KEY='your-secret-access-key'

# Имя бакета для хранения медиафайлов (требуется при STORAGE_TYPE=s3).
AWS_STORAGE_BUCKET_NAME='your-bucket-name'

# Регион S3 (требуется при STORAGE_TYPE=s3).
AWS_S3_REGION_NAME='us-east-1'

# URL эндпоинта S3 для MinIO и S3-совместимых сервисов
# (требуется при STORAGE_TYPE=s3): http://127.0.0.1:9000 для локального MinIO.
AWS_S3_ENDPOINT_URL='http://localhost:9000'

# Имя учетной записи администратора локального MinIO (профиль compose minio).
MINIO_ROOT_USER='minioadmin'

# Пароль учетной записи администратора локального MinIO (профиль compose minio).
MINIO_ROOT_PASSWORD='minioadmin'

# Условное обозначение ресурса S3 (алиас MinIO Client) - используется
# приложением backup для адресации медиа-бакета при STORAGE_TYPE=s3
# и оператором для адресации целей бэкапов с префиксом mc:.
MINIO_ALIAS='local'

# Адрес ресурса S3, включая протокол, имя хоста и номер порта.
MINIO_SERVER_URL='http://127.0.0.1:9000'

# Адрес веб-консоли Minio в случае использования Minio в роли объектного хранилища.
MINIO_BROWSER_REDIRECT_URL='http://127.0.0.1:9001'

# Имя учетной записи ресурса S3.
MINIO_ACCESS_KEY='minioadmin'

# Пароль для доступа к S3.
MINIO_SECRET_KEY='minioadmin'

# Путь до установки MinIO Client. Можно определить командой `which mc`.
# Требуется только при наличии целей бэкапов с префиксом mc:
# или операциях с медиа-бакетом при STORAGE_TYPE=s3.
MC_PATH='/usr/local/bin/mc'

# ----------------------------------------------------------------------------
# Прокси
# Варианты (Traefik в compose, хостовый nginx + certbot): docs/deployment/proxy.md
# ----------------------------------------------------------------------------

# Профили Docker Compose для запуска инфраструктурных сервисов.
# Допустимые значения через запятую: postgres, minio, traefik.
# postgres - локальный контейнер PostgreSQL (обычно достаточно для локальной
# разработки с файловым хранилищем), minio - локальное объектное хранилище
# (разработка с S3), traefik - обратный прокси в Docker Compose (отладка
# прокси-слоя или одиночный сервер «все в Docker»).
# Пусто = все инфраструктурные сервисы внешние (managed-БД, удаленное S3,
# хостовый nginx): поднимается только приложение.
COMPOSE_PROFILES='postgres'

# Номер порта, который прокси-сервер Traefik слушает по протоколу HTTP
# (с последующим редиректом на HTTPS).
TRAEFIK_HTTP_PORT='80'

# Адрес электронной почты для регистрации аккаунта ACME и получения уведомлений
# о сертификатах Let's Encrypt (на этот адрес приходят предупреждения об истечении).
ACME_EMAIL='admin@example.com'

# Имя сертификатного резолвера Traefik для выпуска сертификатов Let's Encrypt.
# Продакшн: 'le' - сертификаты выпускаются через TLS-ALPN-01 challenge.
# Разработка: пустая строка - ACME-клиент пассивен, HTTPS обслуживается
# встроенным self-signed сертификатом Traefik, обращений к Let's Encrypt нет.
TRAEFIK_CERT_RESOLVER=''

# Адрес ACME CA-сервера для Traefik: пусто - продакшен Let's Encrypt;
# тестовые среды указывают staging-каталог
# 'https://acme-staging-v02.api.letsencrypt.org/directory',
# чтобы не исчерпать rate limits продакшена при повторных выпусках
# (сертификаты staging не являются доверенными - только для проверки схемы).
TRAEFIK_ACME_CASERVER=''

# ----------------------------------------------------------------------------
# Бэкапы
# Система резервного копирования (цели, семантика, расписание): docs/deployment/backups.md
# ----------------------------------------------------------------------------

# Имена целей бэкапирования для дампов БД (через пробел); пусто - БД не бэкапируется.
# Каждое имя определяется записью BACKUP_TARGET_<ИМЯ> вида
# 'mc:alias/бакет[/префикс]' или 'rclone:remote:путь' - схема и примеры
# в docs/deployment/backups.md.
BACKUP_DB_TARGETS=''

# Имена целей бэкапирования для медиафайлов (через пробел); пусто - медиа не бэкапируется.
BACKUP_MEDIA_TARGETS=''

# Срок хранения дампов БД в днях: старые дампы удаляются из целей
# и из локального каталога BACKUP_ROOT/db.
BACKUP_DB_RETENTION_DAYS=14

# ----------------------------------------------------------------------------
# Реестры образов и CI
# ----------------------------------------------------------------------------

# Имя учетеной записи Docker для доступа к реестру образов.
DOCKER_USERNAME='dockerusername'

# Пароль учетной записи Docker для доступа к реестру образов.
DOCKER_PASSWORD='qwerty123456'

# Полный адрес реестра образов. Для вытягивания образов с Docker Hub использовать docker.io.
DOCKER_REGISTRY='docker.io'

# Токен, используемый в CI/CD для размещения образа контейнера в реестре GitHub.
GITHUB_TOKEN='suPer1SecRet2gitHub3Token4'

# Маркер окружения CI SourceCraft: устанавливается платформой в CI-заданиях,
# локально не задается (управляет поведением тестов и сборки).
SOURCECRAFT_CI=False
