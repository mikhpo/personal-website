# Должно принимать значение True в продуктивной среде или False в непродуктивной среде.
DEBUG=True/False

# Секретный ключ проекта Django.
SECRET_KEY='secret-django-key'

# Каталог для сохранения статических файлов. Например, /srv/personal-website/static.
# Используется только вне S3-режима (раздача через WhiteNoise).
STATIC_ROOT='/path/to/static/dir'

# Базовый URL статических файлов для Django ({% static %}).
# Локально: '/static/'. В S3-режиме: адрес бакета или CDN с префиксом static/,
# например 'https://storage.yandexcloud.net/<bucket>/static/'.
STATIC_URL='/static/'

# publicPath для webpack-сборки фронтенда: URL-префикс бандлов в webpack-stats.json
# (влияет в том числе на lazy-chunks). Должен совпадать со STATIC_URL используемой среды.
WEBPACK_PUBLIC_PATH='/static/'

# Каталог для хранения загруженных файлов. Например, /srv/personal-website/storage.
STORAGE_ROOT='/path/to/storage/dir'

# Каталог для сохранения бэкапов. Например, /srv/personal-website/backup.
BACKUP_ROOT='/path/to/backups/dir'

# Каталог для сохранения файлов логов. Например, /srv/personal-website/logs.
LOGS_ROOT='/path/to/logs/dir'

# Каталог для сохранения временных файлов. Например, /srv/personal-website/temp.
TEMP_ROOT='/path/to/temp/dir'

# Имя проекта используется в наименовании файлов и путей.
PROJECT_NAME='project_name'

# Имя пользователя PostgreSQL.
POSTGRES_USER='username'

# Пароль пользователя PostgreSQL.
POSTGRES_PASSWORD='password'

# Имя хоста, на котором размещен кластер PostgreSQL.
POSTGRES_HOST='db-hostname'

# Номер порта, по которому доступен кластер PostgreSQL.
POSTGRES_PORT='5432'

# Имя основной базы данных PostgreSQL для сайта.
POSTGRES_DB='db_name'

# SSL для managed-сервисов PostgreSQL (опционально)
# POSTGRES_SSL_MODE - режим SSL (читает Django; стандарт PostgreSQL: disable, allow, prefer, require, verify-ca, verify-full)
#   prefer - пытаться использовать SSL, продолжить без шифрования при недоступности (дефолт для локалки)
#   require - требовать SSL, но не проверять сертификат
#   verify-full - требовать SSL, проверить CA и имя хоста (рекомендуется для managed-сервисов)
#   Подробнее: https://www.postgresql.org/docs/current/libpq-ssl.html
# POSTGRES_SSL_MODE='prefer'
# POSTGRES_SSL_ROOT_CERT_PATH - канонический путь к файлу сертификата CA, который читает Django (sslrootcert).
#   Используется во всех сценариях (bare-metal, Docker-контейнер, Kubernetes pod).
#   Дефолт ~/.postgresql/root.crt (конвенция libpq). Для нестандартного размещения указать абсолютный путь.
# POSTGRES_SSL_ROOT_CERT_PATH=''
# POSTGRES_SSL_CERT_HOST_PATH - путь к сертификату на хосте, куда пишет pgcert.sh и откуда compose монтирует.
#   Нужен только в Docker, когда пути хоста и контейнера различаются. Если не задан — откатывается на POSTGRES_SSL_ROOT_CERT_PATH.
# POSTGRES_SSL_CERT_HOST_PATH=''
# POSTGRES_SSL_CERT_URL - URL для скачивания сертификата CA скриптом scripts/pgcert.sh.
#   Непустое значение — триггер загрузки; пустое — сертификат не скачивается
#   (например, для провайдеров без статического URL: сертификат помещается вручную).
# POSTGRES_SSL_CERT_URL='https://storage.yandexcloud.net/cloud-certs/CA.pem'

# Пример для Яндекс Облака (Managed PostgreSQL):
# POSTGRES_SSL_CERT_URL='https://storage.yandexcloud.net/cloud-certs/CA.pem'
# POSTGRES_HOST='c-<cluster_id>.rw.mdb.yandexcloud.net'
# POSTGRES_PORT='6432'
# POSTGRES_SSL_MODE='verify-full'
# POSTGRES_SSL_ROOT_CERT_PATH можно не задавать — используется конвенция ~/.postgresql/root.crt

# Адрес электронной почты для отправки рассылок.
EMAIL_HOST_USER='username@example.com'

# Пароль от электронной почты для отправки рассылок.
EMAIL_HOST_PASSWORD='email-service-password'

# Имя домена, по которому доступен сайт по протоколу HTTPS.
DOMAIN_NAME='example.com'

# Номер порта, который слушает nginx по умолчанию.
NGINX_PORT='80'

# Токен, используемый в CI/CD для размещения образа контейнера в реестре GitHub.
GITHUB_TOKEN='suPer1SecRet2gitHub3Token4'

# Имя учетеной записи Docker для доступа к реестру образов.
DOCKER_USERNAME='dockerusername'

# Пароль учетной записи Docker для доступа к реестру образов.
DOCKER_PASSWORD='qwerty123456'

# Полный адрес реестра образов. Для вытягивания образов с Docker Hub использовать docker.io.
DOCKER_REGISTRY='docker.io'

# Имя учетной записи для развертывания инстанса Minio.
MINIO_ROOT_USER='minioadmin'

# Пароль учетной записи для развертывания инстанса Minio.
MINIO_ROOT_PASSWORD='minioadmin'

# Условное обозначение ресурса S3 для клиента Minio.
MINIO_ALIAS='local'

# Адрес ресурса S3, включая протокол, имя хоста и номер порта.
MINIO_SERVER_URL='http://127.0.0.1:9000'

# Адрес вэб-консоли Minio в случае использования Minio в роли объектного хранилища.
MINIO_BROWSER_REDIRECT_URL='http://127.0.0.1:9001'

# Имя учетной записи ресурса S3.
MINIO_ACCESS_KEY='minioadmin'

# Пароль для доступа к S3.
MINIO_SECRET_KEY='minioadmin'

# Имя бакета в S3 для сохранения бэкапов.
BACKUP_BUCKET='backups'

# Путь до установки MinIO Client. Можно определить командой `which mc`.
MC_PATH='/usr/local/bin/mc'

# Тип хранилища: filesystem (по умолчанию) или s3
STORAGE_TYPE='filesystem'

# Настройки S3 (требуются только при STORAGE_TYPE=s3)
# Ключ доступа AWS/S3
AWS_ACCESS_KEY_ID='your-access-key-id'

# Секретный ключ AWS/S3
AWS_SECRET_ACCESS_KEY='your-secret-access-key'

# Имя бакета для хранения медиафайлов
AWS_STORAGE_BUCKET_NAME='your-bucket-name'

# Регион S3
AWS_S3_REGION_NAME='us-east-1'

# URL эндпоинта S3 (для MinIO или совместимых сервисов)
AWS_S3_ENDPOINT_URL='http://localhost:9000'
