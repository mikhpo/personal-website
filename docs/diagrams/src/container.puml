@startuml container

!include <C4/C4_Container>

title Архитектура проекта

Person(user, "Пользователь")
Person(admin, "Администратор")
System_Boundary(project, "Персональный сайт") {
    Container(nginx, "Обратный прокси-сервер", "Nginx", "Принимает HTTP-запросы, обслуживает статические файлы, SSL терминирование")
    Container(gunicorn, "WSGI-сервер", "Gunicorn", "Запускает Django приложение, обрабатывает HTTP-запросы")
    Container(backend, "Бэкенд", "Django + DRF", "REST API, бизнес-логика, админка, рендеринг шаблонов")
    Container(frontend, "Фронтенд", "React + Webpack", "React компоненты, интеграция с Django шаблонами, сборка через Webpack")
    Container(scripts, "Скрипты", "Bash", "Запускаются вручную и по расписанию из crontab")
    ContainerDb(db, "База данных", "PostgreSQL", "Хранит информацию о пользователях, статьях, фотографиях и т.д.")
    ContainerDb(s3, "Объектное хранилище", "S3/MinIO", "Хранение медиа-файлов и бэкапов")
}
System_Ext(smtp, "SMTP-сервер", "Внешний сервис электронной почты")

Rel(admin, nginx, "Публикует и редактирует", "HTTPS")
Rel(admin, scripts, "Управляет развертыванием", "SSH")
Rel(user, nginx, "Читает и комментирует", "HTTPS")
Rel(nginx, gunicorn, "Проксирует запросы к API", "HTTPS")
Rel(nginx, frontend, "Обслуживает статические файлы", "HTTP")
Rel(gunicorn, backend, "Запускает Django приложение", "WSGI")
Rel(backend, frontend, "Рендерит шаблоны с React", "django-webpack-loader")
Rel(frontend, backend, "Запрашивает данные через API", "HTTP/REST")
Rel(backend, db, "Читает и записывает данные", "SQL")
Rel(backend, s3, "Хранит медиа-файлы", "S3 API")
Rel(backend, smtp, "Почтовые рассылки", "SMTP")
Rel(smtp, user, "Доставка почты")
Rel(scripts, backend, "Запускает миграции и команды", "CLI")
Rel(scripts, db, "Создает и восстанавливает бэкапы", "pg_dump/pg_restore")
Rel(scripts, s3, "Резервное копирование", "MinIO Client")

@enduml
