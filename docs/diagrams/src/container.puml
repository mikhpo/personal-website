@startuml container

!include <C4/C4_Container>

title Архитектура проекта

Person(user, "Пользователь")
Person(admin, "Администратор")

System_Boundary(server, "Сервер") {
    Container(proxy, "Обратный прокси", "nginx + certbot", "HTTPS, сертификаты, раздача медиа")
    Container(gunicorn, "WSGI-сервер", "Gunicorn", "Запускает Django-приложение")
    Container(backend, "Бэкенд", "Django + DRF", "API, бизнес-логика, резервное копирование")
    Container(frontend, "Фронтенд", "React + Webpack", "Пользовательский интерфейс")
}

System_Ext(db, "База данных", "PostgreSQL")
System_Ext(s3, "Хранилище", "S3 / файловая система")
System_Ext(smtp, "SMTP-сервер", "Внешний сервис")
System_Ext(le, "Let's Encrypt", "ACME-сервер")

Rel(user, proxy, "Читает и комментирует", "HTTPS")
Rel(admin, proxy, "Публикует и редактирует", "HTTPS")
Rel(proxy, gunicorn, "Проксирует запросы", "HTTP")
Rel(gunicorn, backend, "Запускает Django-приложение", "WSGI")
Rel(backend, frontend, "Рендерит шаблоны", "django-webpack-loader")
Rel(frontend, backend, "Запрашивает данные", "HTTP/REST")
Rel(backend, db, "Читает и записывает", "SQL")
Rel(backend, s3, "Хранит медиа и статику", "S3 API / файловая система")
Rel(backend, smtp, "Отправляет письма", "SMTP")
Rel(smtp, user, "Доставка почты")
Rel(proxy, le, "Получает сертификаты", "ACME")

@enduml
