[Unit]
Description=personal-website (Django, Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=${SERVICE_USER}
Group=www-data
WorkingDirectory=${WORK_DIR}
EnvironmentFile=${WORK_DIR}/.env
# Вне STORAGE_TYPE=s3 команда завершается без действий
ExecStartPre=${WORK_DIR}/.venv/bin/python backend/manage.py init_s3
ExecStartPre=${WORK_DIR}/.venv/bin/python backend/manage.py migrate --noinput
# Таблицы очереди не создаются в immediate-режиме DEBUG: SQL-хранилище не используется,
# а команда создания таблиц на нем падает
ExecStartPre=/bin/sh -c 'd=$(printf %s "${DEBUG}" | tr A-Z a-z); case "$d" in true|1|yes|y|ok) exit 0 ;; esac; exec ${WORK_DIR}/.venv/bin/python backend/manage.py create_huey_tables'
ExecStartPre=${WORK_DIR}/.venv/bin/python backend/manage.py collectstatic --noinput
ExecStart=:/bin/bash -c 'exec ${WORK_DIR}/.venv/bin/gunicorn \
    --workers=${GUNICORN_WORKERS:-$((2 * $(nproc --all) + 1))} \
    --max-requests=500 \
    --max-requests-jitter=50 \
    --access-logfile=- \
    --error-logfile=- \
    --pythonpath=${WORK_DIR}/backend \
    personal_website.wsgi:application'
Restart=on-failure
RestartSec=5s
