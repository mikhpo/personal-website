[Unit]
Description=personal-website worker (Django, huey)
# Схему базы данных и таблицы очереди создает веб-юнит в ExecStartPre,
# поэтому воркер стартует после него.
After=network-online.target personal-website.service
Wants=network-online.target

[Service]
User=${SERVICE_USER}
Group=www-data
WorkingDirectory=${WORK_DIR}
EnvironmentFile=${WORK_DIR}/.env
ExecStart=${WORK_DIR}/.venv/bin/python backend/manage.py run_huey
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
